{
  "name": "agent-cleaner",
  "version": "0.1.0",
  "description": "Scan, install, and uninstall skills, hooks, MCPs, and plugins across Claude Code, Cursor, Codex, Grok, OpenCode, and Gemini CLI.",
  "license": "MIT",
  "author": "Mohammad Mahdi Afshar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reloadlife/agent-cleaner.git"
  },
  "bugs": {
    "url": "https://github.com/reloadlife/agent-cleaner/issues"
  },
  "homepage": "https://github.com/reloadlife/agent-cleaner#readme",
  "type": "module",
  "bin": {
    "agent-cleaner": "src/cli.ts"
  },
  "files": [
    "src",
    "catalog",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "tui": "bun src/cli.ts",
    "serve": "bun src/cli.ts serve",
    "scan": "bun src/cli.ts scan --json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "web:build": "bun build src/web/ui/index.html --outdir dist/ui --minify"
  },
  "keywords": [
    "claude-code",
    "cursor",
    "codex",
    "mcp",
    "skills",
    "cli",
    "tui"
  ],
  "dependencies": {
    "hono": "^4.7.0",
    "ink": "^5.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "bun-types": "^1.3.14",
    "typescript": "^5.6.0"
  }
}
